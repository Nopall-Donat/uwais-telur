<% if (suppliers && suppliers.length> 0) { %>
    <table class="table table-hover table-responsive mt-3" id="suppliersTable">
        <thead class="text-center">
            <tr>
                <th scope="col">ID Pemasok</th>
                <th scope="col">Nama Pemasok</th>
                <th scope="col">Alamat</th>
                <th scope="col">Nomor Telepon</th>
                <th scope="col">Tanggal Terdaftar</th>
                <th scope="col">Detail</th>
                <th scope="col">Hapus</th>
            </tr>
        </thead>
        <tbody class="text-center">
            <% suppliers.forEach(supplier=> { %>
                <tr>
                    <td>
                        <%= supplier.supplier_id %>
                    </td>
                    <td>
                        <%= supplier.name %>
                    </td>
                    <td>
                        <%= supplier.address %>
                    </td>
                    <td>
                        <%= supplier.phone_number %>
                    </td>
                    <td>
                        <%= supplier.created_at %>
                    </td>
                    <td>
                        <a href="/suppliers/details/<%= supplier.supplier_id %>"
                            class="btn btn-sm btn-primary">Detail</a>
                    </td>
                    <td>
                        <button class="btn btn-delete btn-danger btn-sm"
                            data-id="<%= supplier.supplier_id %>">Hapus</button>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation example">
            <ul class="pagination">

                <!-- Tombol Previous -->
                <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="javascript:void(0);" data-page="<%= page - 1 %>" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                <!-- Angka 1, 2, 3 -->
                <% for (let i=1; i <=3; i++) { %>
                    <li class="page-item <%= page === i ? 'active' : '' %> <%= i > totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="javascript:void(0);" data-page="<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>

                        <!-- Tombol Next -->
                        <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="javascript:void(0);" data-page="<%= page + 1 %>"
                                aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>

            </ul>
        </nav>
    </div>

    <% } else { %>
        <p class="text-center mt-4">Tidak ada pemasok ditemukan.</p>
        <% } %>