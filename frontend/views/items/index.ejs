<!DOCTYPE html>
<html lang="en">

<%- include('../layout/header') %>

    <body>
        <%- include('../layout/navbar') %>
            <%- include('../layout/sidebar') %>

                <main id="main" class="main">
                    <div class="pagetitle">
                        <h1>
                            <%= title %>
                        </h1>
                        <nav>
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item">Tables</li>
                                <li class="breadcrumb-item active">Data</li>
                            </ol>
                        </nav>
                    </div><!-- End Page Title -->

                    <section class="section">
                        <div class="row">
                            <div class="col-12">
                                <div class="card recent-customers overflow-auto">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <%= title %>
                                        </h5>

                                        <div class="d-flex justify-content-between mb-3">
                                            <!-- Search & Limit -->
                                            <div class="d-flex align-items-center w-25">
                                                <input type="text" id="searchInput" class="form-control me-2"
                                                    placeholder="Cari Stok..." value="<%= search %>">
                                                <select id="limitSelect" class="form-select w-auto">
                                                    <option value="5" <%=limit==5 ? 'selected' : '' %>>5</option>
                                                    <option value="10" <%=limit==10 ? 'selected' : '' %>>10</option>
                                                    <option value="20" <%=limit==20 ? 'selected' : '' %>>20</option>
                                                    <option value="50" <%=limit==50 ? 'selected' : '' %>>50</option>
                                                </select>
                                            </div>
                                            <div>
                                                <button type="button" class="bi bi-plus-lg btn btn-primary mx-2"
                                                    data-bs-toggle="modal" data-bs-target="#tambahBaru"></button>
                                            </div>
                                        </div>

                                        <!-- ALERT MESSAGE -->
                                        <% if (typeof message !=='undefined' && message) { %>
                                            <div class="alert alert-<%= message.type %> alert-dismissible fade show"
                                                role="alert">
                                                <%= message.text %>
                                                    <button type="button" class="btn-close" data-bs-dismiss="alert"
                                                        aria-label="Close"></button>
                                            </div>
                                            <% } %>

                                                <!-- TABEL DATA -->
                                                <div id="itemsTableContainer">
                                                    <%- include('./_table', { items: items, search: search, limit:
                                                        limit, page: page, totalPages: totalPages, message: message,
                                                        title: title }) %>
                                                </div>
                                    </div>

                                    <!-- Modal Tambah Item -->
                                    <div class="modal fade" id="tambahBaru" tabindex="-1">
                                        <div class="modal-dialog modal-xl modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Tambah Stok Barang</h5>
                                                    <button type="button" class="btn-close"
                                                        data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div id="formAlert" class="alert alert-danger d-none" role="alert">
                                                        Semua field wajib diisi dengan benar!
                                                    </div>
                                                    <form id="itemForm" action="/items/add" method="post"
                                                        class="row g-3">
                                                        <div class="col-md-6">
                                                            <label for="item_code" class="form-label">Kode
                                                                Barang</label>
                                                            <input type="text" id="item_code" name="item_code"
                                                                class="form-control" placeholder="Contoh: ITM001"
                                                                required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="item_type" class="form-label">Jenis
                                                                Barang</label>
                                                            <input type="text" id="item_type" name="item_type"
                                                                class="form-control" placeholder="Contoh: Telur Bebek"
                                                                required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="supplier_id" class="form-label">Pemasok</label>
                                                            <select id="supplier_id" name="supplier_id"
                                                                class="form-select select2" required>
                                                                <option value="">-- Pilih Supplier --</option>
                                                                <% suppliers.forEach(s=> { %>
                                                                    <option value="<%= s.supplier_id %>">
                                                                        <%= s.name %> - <%= s.address %>
                                                                    </option>
                                                                    <% }) %>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="unit" class="form-label">Satuan</label>
                                                            <input type="text" id="unit" name="unit"
                                                                class="form-control" placeholder="kg / butir / dll."
                                                                required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="stock_quantity" class="form-label">Jumlah
                                                                Stok</label>
                                                            <input type="number" id="stock_quantity"
                                                                name="stock_quantity" class="form-control"
                                                                placeholder="Masukkan jumlah ..." required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="purchase_price" class="form-label">Harga
                                                                Beli</label>
                                                            <input type="number" id="purchase_price"
                                                                name="purchase_price" class="form-control"
                                                                placeholder="Harga beli dari supplier ..." step="0.01"
                                                                required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label for="selling_price" class="form-label">Harga
                                                                Jual</label>
                                                            <input type="number" id="selling_price" name="selling_price"
                                                                class="form-control"
                                                                placeholder="Harga jual ke pelanggan ..." step="0.01"
                                                                required>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary"
                                                                data-bs-dismiss="modal">Batal</button>
                                                            <button type="submit"
                                                                class="btn btn-success">Simpan</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div> <!-- End Modal -->

                                </div>
                            </div>
                        </div>
                    </section>
                </main>

                <script src="/assets/js/items/indexScript.js"></script>
    </body>
    <%- include('../layout/footer') %>

</html>