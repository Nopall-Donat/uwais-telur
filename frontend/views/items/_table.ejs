<% if (items && items.length > 0) { %>
    <table class="table table-hover table-responsive mt-3" id="itemsTable">
        <thead class="text-center">
            <tr>
                <th scope="col">Kode Barang</th>
                <th scope="col">Jenis Barang</th>
                <th scope="col">Supplier</th>
                <th scope="col">Stok</th>
                <th scope="col">Harga Beli</th>
                <th scope="col">Harga Jual</th>
                <th scope="col">Satuan</th>
                <th scope="col">Detail</th>
                <th scope="col">Hapus</th>
            </tr>
        </thead>
        <tbody class="text-center">
            <% items.forEach(item => { %>
                <tr>
                    <td><%= item.item_code %></td>
                    <td><%= item.item_type %></td>
                    <td><%= item.supplier_name %></td>
                    <td><%= item.stock_quantity %></td>
                    <td>Rp <%= item.purchase_price.toLocaleString('id-ID') %></td>
                    <td>Rp <%= item.selling_price.toLocaleString('id-ID') %></td>
                    <td><%= item.unit %></td>
                    <td>
                        <a href="/items/details/<%= item.item_code %>" class="btn btn-sm btn-primary">Detail</a>
                    </td>
                    <td>
                        <button class="btn btn-delete btn-danger btn-sm" data-id="<%= item.item_code %>">Hapus</button>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination">

                <!-- Tombol Previous -->
                <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="javascript:void(0);" data-page="<%= page - 1 %>" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                <!-- Halaman 1–3 -->
                <% for (let i = 1; i <= 3; i++) { %>
                    <li class="page-item <%= page === i ? 'active' : '' %> <%= i > totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="javascript:void(0);" data-page="<%= i %>"><%= i %></a>
                    </li>
                <% } %>

                <!-- Tombol Next -->
                <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="javascript:void(0);" data-page="<%= page + 1 %>" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>

            </ul>
        </nav>
    </div>

<% } else { %>
    <p class="text-center mt-4">Tidak ada data stok ditemukan.</p>
<% } %>