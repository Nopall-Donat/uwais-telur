<!DOCTYPE html>
<html lang="en">

<%- include('../layout/header') %>

<body>
  <%- include('../layout/navbar') %>
  <%- include('../layout/sidebar') %>

  <main id="main" class="main">

    <div class="pagetitle">
      <h1><%= title %></h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item">Stok Barang</li>
          <li class="breadcrumb-item active">Detail</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">

          <div class="card">
            <div class="card-body pt-4">
              <h5 class="card-title">Detail Barang</h5>

              <form action="/items/update/<%= item.item_code %>" method="POST" class="row g-3">

                <div class="col-md-6">
                  <label for="item_code" class="form-label">Kode Barang</label>
                  <input type="text" id="item_code" class="form-control" value="<%= item.item_code %>" readonly disabled>
                </div>

                <div class="col-md-6">
                  <label for="item_type" class="form-label">Jenis Barang</label>
                  <input type="text" id="item_type" name="item_type" class="form-control" value="<%= item.item_type %>" required>
                </div>

                <div class="col-md-6">
                  <label for="supplier_id" class="form-label">Supplier</label>
                  <select id="supplier_id" name="supplier_id" class="form-select" required>
                    <% suppliers.forEach(supp => { %>
                      <option value="<%= supp.supplier_id %>" <%= item.supplier_id === supp.supplier_id ? 'selected' : '' %>>
                        <%= supp.name %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-6">
                  <label for="stock_quantity" class="form-label">Jumlah Stok</label>
                  <input type="number" id="stock_quantity" name="stock_quantity" class="form-control" value="<%= item.stock_quantity %>" required>
                </div>

                <div class="col-md-6">
                  <label for="purchase_price" class="form-label">Harga Beli</label>
                  <input type="number" id="purchase_price" name="purchase_price" class="form-control" value="<%= item.purchase_price %>" step="0.01" required>
                </div>

                <div class="col-md-6">
                  <label for="selling_price" class="form-label">Harga Jual</label>
                  <input type="number" id="selling_price" name="selling_price" class="form-control" value="<%= item.selling_price %>" step="0.01" required>
                </div>

                <div class="col-md-6">
                  <label for="unit" class="form-label">Satuan</label>
                  <input type="text" id="unit" name="unit" class="form-control" value="<%= item.unit %>" required>
                </div>

                <div class="col-md-6">
                  <label for="updated_at" class="form-label">Terakhir Diupdate</label>
                  <input type="text" id="updated_at" class="form-control" value="<%= item.updated_at %>" readonly disabled>
                </div>

                <div class="d-flex justify-content-between mt-4">
                  <a href="/items" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
                  <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Simpan Perubahan</button>
                </div>

              </form>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main><!-- End #main -->

  <script src="/assets/js/items/indexScript.js"></script>
</body>

<%- include('../layout/footer') %>

</html>