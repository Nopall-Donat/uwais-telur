<% if (sales && sales.length> 0) { %>
    <table class="table table-hover mt-3 mx-auto">
        <thead class="text-center">
            <tr>
                <th>ID Transaksi</th>
                <th>Nama Pelanggan</th>
                <th>Alamat</th>
                <th>Total Tagihan</th>
                <th>Total Bayar</th>
                <th>Status</th>
                <th>Waktu</th>
                <th>Admin</th>
                <th>Detail</th>
                <th>Hapus</th>
            </tr>
        </thead>
        <tbody class="text-center">
            <% sales.forEach(tx=> { %>
                <tr>
                    <td>
                        <%= tx.id %>
                    </td>
                    <td>
                        <%= tx.nama_pelanggan %>
                    </td>
                    <td>
                        <%= tx.alamat_pelanggan %>
                    </td>
                    <td>Rp <%= tx.total_tagihan %>
                    </td>
                    <td>Rp <%= tx.total_bayar %>
                    </td>
                    <td>
                        <span class="badge 
                            <%= tx.status_pembayaran === 'Lunas' ? 'bg-success' :
                                tx.status_pembayaran === 'Belum Lunas' ? 'bg-warning text-dark' :
                                tx.status_pembayaran === 'Dibatalkan' ? 'bg-danger' : 'bg-secondary' %>">
                            <%= tx.status_pembayaran %>
                        </span>                                      
                    </td>                    
                    <td>
                        <%= tx.waktu_transaksi %>
                    </td>
                    <td>
                        <%= tx.nama_admin %>
                    </td>
                    <td><a href="/details/<%= tx.id %>" class="btn btn-sm btn-primary">Detail</a></td>
                    <td><button class="btn btn-sm btn-danger btn-delete" data-id="<%= tx.id %>">Hapus</button></td>
                </tr>
                <% }); %>
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination">
                <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="javascript:void(0);" data-page="<%= page - 1 %>">&laquo;</a>
                </li>

                <% for (let i=1; i <=3; i++) { %>
                    <li class="page-item <%= page === i ? 'active' : '' %> <%= i > totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="javascript:void(0);" data-page="<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>

                        <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="javascript:void(0);" data-page="<%= page + 1 %>">&raquo;</a>
                        </li>
            </ul>
        </nav>
    </div>
    <% } else { %>
        <p class="text-center mt-4">Tidak ada transaksi ditemukan.</p>
        <% } %>