<!DOCTYPE html>
<html lang="en">

<%- include('../layout/header') %>

    <body>
        <%- include('../layout/navbar') %>
            <%- include('../layout/sidebar') %>

                <main id="main" class="main">
                    <div class="pagetitle">
                        <h1>Data Transaksi - <%= detail.id %>
                        </h1>
                        <nav>
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item active">Detail Transaksi</li>
                            </ol>
                        </nav>
                    </div>

                    <!-- Informasi Pelanggan -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Informasi Pelanggan</h5>
                            <ul class="list-group list-group-flush mb-0">
                                <li class="list-group-item"><strong>Nama:</strong>
                                    <%= detail.customer_name %>
                                </li>
                                <li class="list-group-item"><strong>Alamat:</strong>
                                    <%= detail.customer_address %>
                                </li>
                                <li class="list-group-item"><strong>No. HP:</strong>
                                    <%= detail.customer_phone %>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Daftar Pesanan -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Daftar Pesanan</h5>
                            <table class="table table-bordered" id="orderTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID Order</th>
                                        <th>Kode Item</th>
                                        <th>Nama Item</th>
                                        <th>Jumlah</th>
                                        <th>Harga Satuan</th>
                                        <th>Subtotal</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="orderTableBody">
                                    <% if (orders && orders.length> 0) { %>
                                        <% orders.forEach((order, index)=> { %>
                                            <tr data-row-index="<%= index %>">
                                                <td>
                                                    <input type="text" class="form-control" name="order_id[]"
                                                        value="<%= order.sales_order_id %>" readonly>
                                                </td>
                                                <td>
                                                    <select class="form-select item-code-select" name="item_code[]">
                                                        <option value="">-- Pilih --</option>
                                                        <% items.forEach(item=> { %>
                                                            <option value="<%= item.item_code %>"
                                                                <%=item.item_code===order.item_code ? 'selected' : '' %>
                                                                ><%= item.item_code %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control item-name" name="item_name[]"
                                                        value="<%= order.item_type %>" readonly>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control item-qty" name="quantity[]"
                                                        min="1" value="<%= order.quantity %>">
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control item-price"
                                                        name="unit_price[]" min="0" step="100"
                                                        value="<%= order.unit_price %>">
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control item-subtotal"
                                                        name="subtotal[]" value="<%= order.subtotal_price %>" readonly>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-danger btn-sm btn-delete-row">🗑️</button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <!-- Jika belum ada pesanan -->
                                                    <tr>
                                                        <td colspan="7" class="text-center text-muted">Tidak ada
                                                            pesanan.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>

                            </table>
                            <button type="button" class="btn btn-sm btn-primary" id="btnTambahOrder">
                                <i class="bi bi-plus"></i> Tambah Item
                            </button>
                        </div>
                    </div>

                    <!-- Informasi Transaksi -->
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Informasi Transaksi</h5>
                            <ul class="list-group list-group-flush mb-0">
                                <li class="list-group-item"><strong>Admin:</strong>
                                    <%= detail.admin_name %>
                                </li>
                                <li class="list-group-item"><strong>Waktu Transaksi:</strong>
                                    <%= detail.transaction_time %>
                                </li>
                                <li class="list-group-item"><strong>Status Pembayaran:</strong>
                                    <%= detail.status_pembayaran %>
                                </li>
                                <li class="list-group-item"><strong>Total Tagihan:</strong> Rp <span id="totalAmount">
                                        <%= detail.total_tagihan %>
                                    </span></li>
                            </ul>
                        </div>
                    </div>
                </main>

                <script id="saved-orders" type="application/json">
                    <%- JSON.stringify(orders.map(o => o.sales_order_id)) %>
                </script>                  

                <!-- Data item disimpan di script terpisah -->
                <script id="item-data" type="application/json">
                    <%- JSON.stringify(items).replace(/</g, '\\u003c') %>
                </script>

                <script src="/assets/js/pageScript/sales.js"></script>
    </body>
    <%- include('../layout/footer') %>

</html>