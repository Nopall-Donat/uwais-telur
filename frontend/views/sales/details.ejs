<!DOCTYPE html>
<html lang="en">

<%- include('../layout/header') %>

    <body>
        <%- include('../layout/navbar') %>
            <%- include('../layout/sidebar') %>

                <main id="main" class="main">
                    <div class="pagetitle">
                        <h1>
                            <%= title %>
                        </h1>
                    </div>

                    <section class="section">
                        <div class="row">
                            <div class="col-lg-12">

                                <div class="card">
                                    <div class="card-body pt-4">
                                        <h5 class="card-title">Informasi Transaksi</h5>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <strong>ID Transaksi:</strong>
                                                <%= detail.id %><br>
                                                    <strong>Nama Pelanggan:</strong>
                                                    <%= detail.customer_name %><br>
                                                        <strong>Alamat:</strong>
                                                        <%= detail.customer_address %><br>
                                                            <strong>No. HP:</strong>
                                                            <%= detail.customer_phone %>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Admin:</strong>
                                                <%= detail.admin_name %><br>
                                                    <strong>Status:</strong>
                                                    <%= detail.status_pembayaran %><br>
                                                        <strong>Waktu Transaksi:</strong>
                                                        <%= detail.transaction_time %><br>
                                                            <strong>Total Tagihan:</strong> Rp <%= detail.total_tagihan
                                                                %>
                                            </div>
                                        </div>

                                        <hr>

                                        <h5 class="mt-4">Rincian Pesanan</h5>
                                        <% if (detail.orders.length> 0) { %>
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Item</th>
                                                        <th>Kode</th>
                                                        <th>Jumlah</th>
                                                        <th>Harga Satuan</th>
                                                        <th>Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% detail.orders.forEach(order=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= order.item_type %>
                                                            </td>
                                                            <td>
                                                                <%= order.item_code %>
                                                            </td>
                                                            <td>
                                                                <%= order.quantity %>
                                                            </td>
                                                            <td>Rp <%= order.unit_price %>
                                                            </td>
                                                            <td>Rp <%= order.subtotal_price %>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                </tbody>
                                            </table>
                                            <% } else { %>
                                                <p class="text-muted">Belum ada item yang ditambahkan.</p>
                                                <% } %>

                                                    <hr>

                                                    <h5 class="mt-4">Pembayaran</h5>
                                                    <% if (detail.payments.length> 0) { %>
                                                        <table class="table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Jumlah</th>
                                                                    <th>Metode</th>
                                                                    <th>Waktu</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% detail.payments.forEach(pay=> { %>
                                                                    <tr>
                                                                        <td>Rp <%= pay.payment_amount %>
                                                                        </td>
                                                                        <td>
                                                                            <%= pay.payment_method %>
                                                                        </td>
                                                                        <td>
                                                                            <%= pay.payment_time %>
                                                                        </td>
                                                                    </tr>
                                                                    <% }); %>
                                                            </tbody>
                                                        </table>
                                                        <% } else { %>
                                                            <p class="text-muted">Belum ada pembayaran.</p>
                                                            <% } %>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>
                </main>

                <%- include('../layout/footer') %>
    </body>

</html>