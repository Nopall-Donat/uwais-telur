<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Nota Transaksi - <%= transaction.sales_transaction_id %>
    </title>
    <style>
        body {
            font-family: monospace;
            font-size: 11px;
            margin: 14pt;
            padding: 0;
        }

        .center {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            margin-bottom: 10px;
        }

        th,
        td {
            padding: 2px 4px;
            text-align: left;
        }

        th {
            border-bottom: 1px solid #000;
        }

        .totals {
            margin-top: 10px;
            text-align: right;
            font-weight: bold;
        }

        .footer {
            margin-top: 20px;
            text-align: center;
        }

        @media print {
            @page {
                size: 9.5in 11in;
                margin: 0.5in;
            }
        }
    </style>
</head>

<body onload="window.print()">

    <div class="center">
        <h2 style="margin: 0;">TOKO UWAIS TELUR</h2>
        <p style="margin: 0;">Jl. Contoh Alamat, No. 123 - Telp: 0812-3456-7890</p>
        <p style="margin-top: 5px;">NOTA TRANSAKSI</p>
    </div>

    <hr>

    <p><strong>No Transaksi:</strong>
        <%= transaction.sales_transaction_id %>
    </p>
    <p><strong>Tanggal:</strong>
        <%= transaction.transaction_time %>
    </p>
    <p><strong>Pelanggan:</strong>
        <%= transaction.customer_name %> (<%= transaction.phone_number %>)
    </p>
    <p><strong>Alamat:</strong>
        <%= transaction.address %>
    </p>
    <p><strong>Admin:</strong>
        <%= transaction.admin_name %>
    </p>
    <p><strong>Status:</strong>
        <%= transaction.status %>
    </p>

    <hr>

    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Barang</th>
                <th>Qty</th>
                <th>Harga</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            <% let total=0; orders.forEach((item, index)=> { total += item.subtotal_price; %>
                <tr>
                    <td>
                        <%= index + 1 %>
                    </td>
                    <td>
                        <%= item.item_name %>
                    </td>
                    <td>
                        <%= item.quantity %>
                            <%= item.unit %>
                    </td>
                    <td>Rp <%= item.unit_price.toLocaleString('id-ID') %>
                    </td>
                    <td>Rp <%= item.subtotal_price.toLocaleString('id-ID') %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

    <div class="totals">
        Total: Rp <%= total.toLocaleString('id-ID') %>
    </div>

    <% if (payments.length> 0) { %>
        <h4>Pembayaran:</h4>
        <table>
            <thead>
                <tr>
                    <th>No</th>
                    <th>Metode</th>
                    <th>Jumlah</th>
                    <th>Waktu</th>
                </tr>
            </thead>
            <tbody>
                <% payments.forEach((pay, i)=> { %>
                    <tr>
                        <td>
                            <%= i + 1 %>
                        </td>
                        <td>
                            <%= pay.payment_method %>
                        </td>
                        <td>Rp <%= pay.payment_amount.toLocaleString('id-ID') %>
                        </td>
                        <td>
                            <%= pay.payment_time %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
        <% } %>

            <div class="footer">
                <p>--- Terima kasih atas pembelian Anda ---</p>
            </div>

</body>

</html>