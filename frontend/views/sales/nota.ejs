<!DOCTYPE html>
<html>

<head>
    <title>Nota Transaksi - <%= transaction.sales_transaction_id %>
    </title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .header {
            text-align: center;
        }

        .info {
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th,
        td {
            border: 1px solid #aaa;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f0f0f0;
        }

        .total {
            text-align: right;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="header">
        <h2>Toko Uwais Telur</h2>
        <p>Nota Transaksi</p>
    </div>

    <div class="info">
        <p><strong>No Transaksi:</strong>
            <%= transaction.sales_transaction_id %>
        </p>
        <p><strong>Tanggal:</strong>
            <%= transaction.transaction_time %>
        </p>
        <p><strong>Pelanggan:</strong>
            <%= transaction.customer_name %> - <%= transaction.phone_number %>
        </p>
        <p><strong>Alamat:</strong>
            <%= transaction.address %>
        </p>
        <p><strong>Admin:</strong>
            <%= transaction.admin_name %>
        </p>
        <p><strong>Status:</strong>
            <%= transaction.status %>
        </p>
    </div>

    <h4>Detail Pesanan:</h4>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Nama Barang</th>
                <th>Jumlah</th>
                <th>Harga Satuan</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            <% let total=0; orders.forEach((item, index)=> { total += item.subtotal_price; %>
                <tr>
                    <td>
                        <%= index + 1 %>
                    </td>
                    <td>
                        <%= item.item_name %>
                    </td>
                    <td>
                        <%= item.quantity %>
                            <%= item.unit %>
                    </td>
                    <td>Rp <%= item.unit_price.toLocaleString() %>
                    </td>
                    <td>Rp <%= item.subtotal_price.toLocaleString() %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="total">Total Tagihan</td>
                <td>Rp <%= total.toLocaleString() %>
                </td>
            </tr>
        </tfoot>
    </table>

    <% if (payments.length> 0) { %>
        <h4>Pembayaran:</h4>
        <table>
            <thead>
                <tr>
                    <th>No</th>
                    <th>Metode</th>
                    <th>Jumlah</th>
                    <th>Waktu</th>
                </tr>
            </thead>
            <tbody>
                <% payments.forEach((pay, i)=> { %>
                    <tr>
                        <td>
                            <%= i + 1 %>
                        </td>
                        <td>
                            <%= pay.payment_method %>
                        </td>
                        <td>Rp <%= pay.payment_amount.toLocaleString() %>
                        </td>
                        <td>
                            <%= pay.payment_time %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
        <% } %>

            <script>
                window.print();
            </script>
</body>

</html>