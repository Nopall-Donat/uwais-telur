<!DOCTYPE html>
<html lang="en">

<%- include('../layout/header') %>
    <style>
        .is-invalid {
            border: 2px solid #dc3545;
            animation: shake 0.3s;
        }

        @keyframes shake {

            0%,
            100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            50% {
                transform: translateX(5px);
            }

            75% {
                transform: translateX(-5px);
            }
        }
    </style>

    <body>

        <%- include('../layout/navbar') %>

            <!-- ======= Sidebar ======= -->
            <%- include('../layout/sidebar') %>

                <main id="main" class="main">

                    <div class="pagetitle">
                        <h1>
                            <%= title %>
                        </h1>
                        <nav>
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item">Tables</li>
                                <li class="breadcrumb-item active">Data</li>
                            </ol>
                        </nav>
                    </div><!-- End Page Title -->

                    <section class="section">
                        <div class="row">
                            <div class="col-12">
                                <div class="card recent-customers overflow-auto">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <%= title %>
                                        </h5>

                                        <div class="d-flex justify-content-between">
                                            <!-- SEARCH DAN LIMIT -->
                                            <div class="d-flex align-items-center w-25">
                                                <div class="search-bar p-1 border border-2 my-2">
                                                    <input id="searchInput" type="text" class="border-0"
                                                        placeholder="Search" aria-label="Search"
                                                        aria-describedby="basic-addon1" value="<%= search %>">
                                                    <a href="javascript:void(0);" class="bx-color"><i
                                                            class="bi bi-search"></i></a>
                                                </div>
                                                <div class="dropdown m-2">
                                                    <select id="limitSelect" class="form-select"
                                                        aria-label="Select Limit">
                                                        <option value="5" <%=limit==5 ? 'selected' : '' %>>5</option>
                                                        <option value="10" <%=limit==10 ? 'selected' : '' %>>10</option>
                                                        <option value="15" <%=limit==15 ? 'selected' : '' %>>15</option>
                                                        <option value="20" <%=limit==20 ? 'selected' : '' %>>20</option>
                                                        <option value="30" <%=limit==30 ? 'selected' : '' %>>30</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- BUTTON TAMBAH -->
                                            <div class="d-flex align-items-center w-25 justify-content-end mx-2">
                                                <button type="button" class="bi bi-plus-lg btn btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#tambahBaru"></button>
                                            </div>
                                        </div>

                                        <!-- ALERT MESSAGE -->
                                        <% if (typeof message !=='undefined' && message) { %>
                                            <div class="alert alert-<%= message.type %> alert-dismissible fade show"
                                                role="alert">
                                                <%= message.text %>
                                                    <button type="button" class="btn-close" data-bs-dismiss="alert"
                                                        aria-label="Close"></button>
                                            </div>
                                            <% } %>

                                                <!-- TABEL DATA -->
                                                <div id="customersTableContainer">
                                                    <%- include('./_table', { customers: customers }) %>
                                                </div>

                                    </div> <!-- End of card-body -->

                                    <!-- Modal tambah pelanggan tetap diluar container -->
                                    <div class="modal fade" id="tambahBaru" tabindex="-1">
                                        <div class="modal-dialog modal-xl modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Tambah Pelanggan</h5>
                                                    <button type="button" class="btn-close"
                                                        data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div id="formAlert" class="alert alert-danger d-none" role="alert">
                                                        Semua field wajib diisi dengan benar!
                                                    </div>
                                                    <form id="customerForm" action="/customers/add" method="post"
                                                        class="row g-3">
                                                        <form id="customerForm" action="/customers/add" method="post"
                                                            class="row g-3">
                                                            <div class="col-md-12">
                                                                <label for="name" class="form-label">Nama
                                                                    Pelanggan</label>
                                                                <input type="text" id="name" name="name"
                                                                    class="form-control"
                                                                    placeholder="Masukkan Nama ...">
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label for="phone_number" class="form-label">No
                                                                    Handphone</label>
                                                                <input type="tel" id="phone_number" name="phone_number"
                                                                    class="form-control"
                                                                    placeholder="Masukkan Nomor ..."
                                                                    pattern="^\d{10,13}$">
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label for="address" class="form-label">Alamat</label>
                                                                <textarea id="address" name="address"
                                                                    class="form-control"
                                                                    placeholder="Masukkan Alamat ..."></textarea>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary"
                                                                    data-bs-dismiss="modal">Close</button>
                                                                <button type="submit" class="btn btn-success">Save
                                                                    changes</button>
                                                            </div>
                                                        </form>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                </main><!-- End #main -->

                <!-- ======= Footer ======= -->
                <%- include('../layout/footer') %>

    </body>
    <%- include('./scriptCustomer') %>

</html>