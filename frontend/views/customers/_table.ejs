<% if (customers && customers.length > 0) { %>
    <table class="table table-hover table-responsive mt-3" id="customersTable">
        <thead>
            <tr>
                <th scope="col">ID Pelanggan</th>
                <th scope="col">Nama Pelanggan</th>
                <th scope="col">Alamat</th>
                <th scope="col">Nomor Telepon</th>
                <th scope="col">Tanggal Bergabung</th>
                <th scope="col">Aksi</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td><%= customer.customer_id %></td>
                    <td><%= customer.name %></td>
                    <td><%= customer.address %></td>
                    <td><%= customer.phone_number %></td>
                    <td><%= customer.created_at %></td>
                    <td>
                        <a href="/customers/details/<%= customer.customer_id %>" class="btn btn-sm btn-primary">Detail</a>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger" onclick="deleteCustomer('<%= customer.customer_id %>')">Delete</button>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p class="text-center mt-4">Tidak ada pelanggan ditemukan.</p>
<% } %>
