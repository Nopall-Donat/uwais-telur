<script>
// Fungsi untuk menyimpan state dropdown ke localStorage
function saveDropdownState(dropdownId, isOpen) {
    localStorage.setItem(dropdownId, isOpen);
}

// Fungsi untuk mendapatkan state dropdown dari localStorage
function getDropdownState(dropdownId) {
    // Jika tidak ada state tersimpan, kembalikan false (tertutup)
    return localStorage.getItem(dropdownId) === 'true' ? true : false;
}

// Fungsi untuk menginisialisasi dropdown berdasarkan state yang tersimpan
function initializeDropdowns() {
    const dropdowns = ['forms-nav', 'tables-nav'];
    
    dropdowns.forEach(dropdownId => {
        const dropdownElement = document.getElementById(dropdownId);
        const isOpen = getDropdownState(dropdownId);
        const parentNavLink = dropdownElement.previousElementSibling;
        
        if (isOpen) {
            dropdownElement.classList.add('show');
            if (parentNavLink) {
                parentNavLink.classList.remove('collapsed');
                parentNavLink.setAttribute('aria-expanded', 'true');
            }
        } else {
            dropdownElement.classList.remove('show');
            if (parentNavLink) {
                parentNavLink.classList.add('collapsed');
                parentNavLink.setAttribute('aria-expanded', 'false');
            }
        }
    });
}

// Event listener untuk dropdown
document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
    button.addEventListener('click', function() {
        const target = this.getAttribute('data-bs-target').replace('#', '');
        const targetElement = document.getElementById(target);
        const isCurrentlyOpen = !targetElement.classList.contains('show');
        saveDropdownState(target, isCurrentlyOpen);
    });
});

// Jalankan inisialisasi saat halaman dimuat
document.addEventListener('DOMContentLoaded', initializeDropdowns);
</script>